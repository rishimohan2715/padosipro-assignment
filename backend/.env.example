# Server
PORT=4000
NODE_ENV=development

# Database (SQLite file path, relative to backend/)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# OTP
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Mail
# "console" (default): print the OTP to the server console — zero setup, no SMTP needed.
# "smtp": send real email via the SMTP_* settings below (use Mailpit locally).
MAIL_TRANSPORT=console
MAIL_FROM="PadosiPro <no-reply@padosipro.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
