# Server
PORT=4000
NODE_ENV=development

# Database (SQLite file path, relative to backend/)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# OTP
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Mail — three transports:
#   console (default) : print the OTP to the server console. Zero setup.
#   smtp              : real email over SMTP. Good locally; many PaaS hosts
#                       block outbound ports 25/465/587, so see "brevo" below.
#   brevo             : real email over Brevo's HTTPS API (port 443). Use this
#                       when deployed — it works where SMTP is blocked.
MAIL_TRANSPORT=console
MAIL_FROM="PadosiPro <no-reply@padosipro.local>"

# For MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# For MAIL_TRANSPORT=brevo — the API key (xkeysib-…), NOT the SMTP key
BREVO_API_KEY=
